rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Donations collection:
    // Public read for everyone (donors, shelters, visitors)
    // Public write for donors submitting listings and shelters applying for food
    match /donations/{donationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Audit logs collection:
    // Transparent public record of all surplus food rescue actions
    match /audit_logs/{logId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Registered users & profiles:
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Application settings:
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
